# Copy this file to .env and fill in real values. Never commit .env.

# Staging URL the tests run against.
BASE_URL=https://stg.hoaworkflow.io

# Real QA account used for happy-path / authenticated tests (see tests/auth.setup.ts).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# An email guaranteed not to have an account, used for no-enumeration checks.
# Defaults to qa-test-nonexistent-xyz@example.com if left unset.
UNKNOWN_USER_EMAIL=
